# tdvmm corpus (configpipeline) worker image -- a build: context.
#
# Built HOST-SIDE at bake time only; the output flows through the SAME squash /
# seed-store / compose.lock pipeline as any image:. The base is DIGEST-PINNED
# (bake-stack rejects a non-digest-pinned FROM). No apk: the worker only needs the
# base Alpine busybox shell, so the build needs only the pinned base pull.
FROM docker.io/library/alpine@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
COPY worker.sh /usr/local/bin/worker.sh
RUN chmod 0755 /usr/local/bin/worker.sh
ENTRYPOINT ["/bin/sh", "/usr/local/bin/worker.sh"]
