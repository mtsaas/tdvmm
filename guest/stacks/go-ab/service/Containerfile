# deterministic-vmm Phase-2b Go A/B service image (a build: context).
#
# Built HOST-SIDE at bake time only (guest/bake-stack.sh: podman build
# --squash-all --timestamp <epoch>), NEVER inside the guest. The output flows
# through the SAME squash / seed-store / compose.lock pipeline as any image:.
#
# Both base images are DIGEST-PINNED (closed-world + reproducibility discipline;
# bake-stack rejects a non-digest-pinned FROM). The result is a single squashed
# vfs layer whose DiffID is the recorded CONTENT-IDENTITY (see stack.lock /
# images.lock) — image IDs are not reproducible, filesystem content is.
#
# Reproducible build: the Go toolchain is the pinned golang image (GOTOOLCHAIN=
# local so nothing is downloaded), and the binary is built with -trimpath
# -buildvcs=false -buildid= and CGO_ENABLED=0 (static, no host paths, no VCS
# stamp) so its bytes are identical across independent bakes. --timestamp then
# normalizes every file mtime in the image (a SOURCE_DATE_EPOCH-style pass), so
# the squashed layer's DiffID is stable bake-to-bake.

# ---- builder: pinned Go toolchain (go1.26.5) -------------------------------
FROM docker.io/library/golang@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS build
WORKDIR /src
COPY go.mod .
COPY main.go .
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
RUN go build -trimpath -buildvcs=false -ldflags="-s -w -buildid=" -o /dvmm-go-service .

# ---- runtime: Alpine + the Postgres 16 client (same as the shell service) --
# GOGC (default 100) and GOMAXPROCS (defaults to the single guest vCPU = 1) are
# intentionally NOT set — measure the runtime defaults.
FROM docker.io/library/alpine@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk add --no-cache postgresql16-client=16.14-r0
COPY --from=build /dvmm-go-service /usr/local/bin/dvmm-go-service
ENTRYPOINT ["/usr/local/bin/dvmm-go-service"]
