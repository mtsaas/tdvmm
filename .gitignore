# Rust build output
/target

# Reference sources (studied, not vendored) — cloned locally, not committed
/vendor-ref

# Bootstrap kernel image (40 MiB prebuilt vmlinux). Rebuild with
# guest/kernel/build_kernel.sh, or re-download per README.
/guest/kernel/vmlinux-*
/guest/kernel/linux-*/

# Kernel build tool binary (source gen_init_cpio.c is committed)
/guest/initramfs/gen_init_cpio

# Alpine container guest: the large built initramfs (~150 MiB) and the
# downloaded pinned minirootfs are rebuildable via build_rootfs.sh (the
# reproducibility anchor). packages.lock, images.lock, the scripts, and the
# artifact hash (initramfs-alpine.cpio.gz.sha256) ARE committed.
/guest/initramfs-alpine/initramfs-alpine.cpio.gz
/guest/initramfs-alpine/alpine-minirootfs-*.tar.gz

# Phase 2a: pinned compose engine binary (fetched + sha256-verified) and the
# per-stack baked initramfs images are rebuildable via bake-stack.sh.
/guest/initramfs-alpine/docker-compose-*
/guest/initramfs-alpine/initramfs-alpine-*.cpio.gz
/guest/initramfs-alpine/initramfs-alpine-*.cpio.gz.sha256

# OP-1a: the single-file .dvmm artifacts (bake-stack.sh output) are rebuildable;
# the manifest anchors live in each stack's stack.lock, which IS committed.
*.dvmm

# goal-3a: the content-hash bake cache, the runner's scratch TMPDIR, and the
# per-run test results (JSON + logs). All rebuildable / transient.
/.dvmm-cache
/.dvmm-tmp
/.dvmm-test-results
