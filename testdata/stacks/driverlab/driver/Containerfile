# tdvmm driverlab — a minimal driver image: one static Go binary, nothing else.
#
# Built HOST-SIDE at bake time. Both bases are DIGEST-PINNED and the Go build is
# CGO-free and -trimpath, so two --no-cache bakes are byte-identical. The final
# base is the same busybox digest the peer service uses; the driver only speaks
# to the harness over the control socket, so it needs no other libraries.

FROM docker.io/library/golang@sha256:457d8584db11412777c4196146b8060fdaabe0b0ba7b62c553d08e07d8c22bd3 AS build
WORKDIR /src
COPY go.mod ./
COPY sdk/ ./sdk/
COPY driver.go ./
ENV CGO_ENABLED=0 GOFLAGS=-mod=mod GOPROXY=off GOTOOLCHAIN=local
RUN go build -trimpath -ldflags "-s -w -buildid=" -o /driver .

FROM docker.io/library/busybox@sha256:dc2d74b28e4cf8984fa52af1f39bc7c3d9c73760b41a74d629f5d11b1ab28616
COPY --from=build /driver /driver
ENTRYPOINT ["/driver"]
